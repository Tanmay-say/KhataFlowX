NODE_ENV=development
PORT=8001
APP_URL=http://localhost:5173
API_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:5173

# Supabase project
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Payments: mock mode is for development only
PAYMENT_PROVIDER=mock
ALLOW_MOCK=false
PAYTM_MID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE=
PAYTM_ENV=staging
PORTAL_SIGNING_SECRET=
PORTAL_LINK_TTL_HOURS=72

# Telegram bots; polling starts when the API starts if tokens are provided
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_CLIENT_BOT_TOKEN=
TELEGRAM_ADMIN_BOT_USERNAME=
TELEGRAM_CLIENT_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_MODE=polling

# Muse / Meta
MUSE_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
MUSE_REASONING_EFFORT=minimal
MUSE_TIMEOUT_MS=30000
MUSE_FALLBACK_MODEL=

# Sarvam voice
SARVAM_API_KEY=
SARVAM_API_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=transcribe
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
VOICE_MAX_SECONDS=30
TTS_ENABLED=true

MODEL_API_KEY=
