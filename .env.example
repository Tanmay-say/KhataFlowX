# API local defaults (optional until the API needs non-default settings)
NODE_ENV=development
PORT=8001
APP_URL=http://localhost:5173
API_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:5173

# Supabase project (needed for app auth/API integration)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Database checks only. Use a development project; never put these in frontend env.
# Supabase Dashboard → Connect → Transaction pooler; port 6543, database postgres.
SUPABASE_TRANSACTION_POOLER=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@<region>.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_PASSWORD=<database-password>


# Sarvam
SARVAM_API_KEY=                     # sent as header: api-subscription-key
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saaras:v3          # verify latest via Sarvam docs MCP; quickstart also shows v4
SARVAM_STT_MODE=transcribe          # transcribe | translate | verbatim | translit | codemix
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
VOICE_MAX_SECONDS=30
TTS_ENABLED=true

# Telegram
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_CLIENT_BOT_TOKEN=
TELEGRAM_ADMIN_BOT_USERNAME=
TELEGRAM_CLIENT_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=            # random; validate X-Telegram-Bot-Api-Secret-Token
TELEGRAM_MODE=polling               # polling (dev) | webhook (prod)

# Payments
PAYMENT_PROVIDER=mock               # mock | paytm
PAYTM_MID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE=
PAYTM_ENV=staging

# Security
PORTAL_SIGNING_SECRET=              # ≥32 random bytes
PORTAL_LINK_TTL_HOURS=72
SARVAM_API_URL=https://api.sarvam.ai/v1
SARVAM_MODEL=sarvam-mini-4b
MUSE_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
MUSE_REASONING_EFFORT=minimal
MUSE_TIMEOUT_MS=30000
MUSE_FALLBACK_MODEL=
MODEL_API_KEY=

